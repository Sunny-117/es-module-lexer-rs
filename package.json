{
  "name": "es-module-lexer-rs-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Rust implementation of es-module-lexer with Node.js bindings",
  "scripts": {
    "build": "pnpm -r build",
    "build:main": "pnpm --filter es-module-lexer-rs build",
