    "publish:platforms": "cd packages/es-module-lexer-rs && ./scripts/publish-platform-packages.sh"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
